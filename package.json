{
  "name": "plasmic-static",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:static": "npm run build && node snap.mjs"
  },
  "reactSnap": {
    "source": "dist",
    "include": [
      "/",
      "/?component=LandingTop"
    ],
    "inlineCss": true,
    "skipThirdPartyRequests": false,
    "crawl": false,
    "puppeteerArgs": [
      "--no-sandbox",
      "--disable-setuid-sandbox"
    ],
    "minifyHtml": {
      "collapseWhitespace": false
    },
    "timeout": 60000
  },
  "dependencies": {
    "@plasmicapp/loader": "^0.0.59",
    "@plasmicapp/loader-react": "^1.0.402",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-legacy": "^7.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "puppeteer": "^24.29.1",
    "react-snap": "^1.23.0",
    "vite": "^7.1.7"
  }
}